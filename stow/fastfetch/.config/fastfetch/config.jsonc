// dotfiles: fastfetch. Nothing palette, no logo wordmark, no rainbow keys.
//
// Colours are ANSI numbers on purpose (1 = red, 8 = grey, 7 = white): fastfetch
// then paints with the terminal's own 16 colours, so this file follows the
// Ghostty palette instead of carrying a second copy of it.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "none"
  },
  "display": {
    "separator": "  "
  },
  "modules": [
    {
      "type": "title",
      "keyColor": "1"
    },
    "break",
    {
      "type": "os",
      "key": "os",
      "keyColor": "8"
    },
    {
      "type": "kernel",
      "key": "kernel",
      "keyColor": "8"
    },
    {
      "type": "wm",
      "key": "wm",
      "keyColor": "8"
    },
    {
      "type": "shell",
      "key": "shell",
      "keyColor": "8"
    },
    {
      "type": "terminal",
      "key": "term",
      "keyColor": "8"
    },
    "break",
    {
      "type": "cpu",
      "key": "cpu",
      "keyColor": "8"
    },
    {
      "type": "gpu",
      "key": "gpu",
      "keyColor": "8"
    },
    {
      "type": "memory",
      "key": "mem",
      "keyColor": "8"
    },
    {
      "type": "disk",
      "key": "disk",
      "keyColor": "8"
    },
    "break",
    {
      "type": "colors",
      "paddingLeft": 1
    }
  ]
}
